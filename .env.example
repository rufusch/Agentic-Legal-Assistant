# Generate once on the server: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKEND_ENCRYPTION_KEY=
# Exact Antigravity browser origins, separated by commas; no wildcard.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500,https://your-frontend.example
REVIEW_MODEL=qwen3:4b-instruct
DRAFTING_MODEL=qwen3:4b-instruct
# For a separately hosted schema-compatible model service (without the compose model):
# LEXIMIND_MODEL_DEPLOYMENT=cloud
# LEXIMIND_REVIEW_LLM_PROVIDER=compatible
# LEXIMIND_REVIEW_BASE_URL=https://your-model-service.example
# LEXIMIND_REVIEW_LLM_MODEL=your-model-id
# LEXIMIND_REVIEW_API_KEY=server-secret-only
# Independently activate a later fine-tuned drafting model (same server by default):
# LEXIMIND_DRAFTING_LLM_MODEL=your-drafting-model-or-adapter-id
# LEXIMIND_DRAFTING_BASE_URL=https://your-drafting-model-service.example
# LEXIMIND_DRAFTING_LLM_PROVIDER=compatible
# LEXIMIND_DRAFTING_API_KEY=server-secret-only

RESEARCH_MODEL=qwen3:4b-instruct
# LEXIMIND_RESEARCH_LLM_MODEL=your-separately-trained-research-model
# LEXIMIND_RESEARCH_BASE_URL=https://your-model-service.example
# LEXIMIND_RESEARCH_LLM_PROVIDER=compatible
# LEXIMIND_RESEARCH_API_KEY=server-secret-only

CHAT_MODEL=qwen3:4b-instruct
# LEXIMIND_CHAT_LLM_MODEL=your-separately-trained-chat-model
# LEXIMIND_CHAT_BASE_URL=https://your-model-service.example
# LEXIMIND_CHAT_LLM_PROVIDER=compatible
# LEXIMIND_CHAT_API_KEY=server-secret-only

# Maximum output tokens per model pass (256–16000); long drafts need a larger budget.
LEXIMIND_MODEL_MAX_OUTPUT_TOKENS=4000

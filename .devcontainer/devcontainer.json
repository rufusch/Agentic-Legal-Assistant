{
  "name": "CaseLens",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "remoteUser": "vscode",
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "CaseLens website", "onAutoForward": "openBrowser", "protocol": "http" }
  },
  "postCreateCommand": "bash scripts/setup-codespaces.sh",
  "postAttachCommand": "echo 'Start CaseLens: bash scripts/start-codespaces.sh (or run the Start CaseLens task)'",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": { "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python" }
    }
  }
}
